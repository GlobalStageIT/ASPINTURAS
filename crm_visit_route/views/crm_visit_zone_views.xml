<odoo>
  <record id="view_crm_visit_zone_tree" model="ir.ui.view">
    <field name="name">crm.visit.zone.tree</field>
    <field name="model">crm.visit.zone</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="color"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_crm_visit_zone_form" model="ir.ui.view">
    <field name="name">crm.visit.zone.form</field>
    <field name="model">crm.visit.zone</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="color"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
