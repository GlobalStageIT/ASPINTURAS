<odoo>
  <record id="view_crm_visit_list" model="ir.ui.view">
    <field name="name">crm.visit.list</field>
    <field name="model">crm.visit</field>
    <field name="arch" type="xml">
      <tree>
        <field name="priority" widget="priority"/>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="user_id"/>
        <field name="zone_id"/>
        <field name="scheduled_date"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="view_crm_visit_search" model="ir.ui.view">
    <field name="name">crm.visit.search</field>
    <field name="model">crm.visit</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="user_id"/>
        <field name="zone_id"/>
        <filter name="my" string="Mías" domain="[('user_id', '=', uid)]"/>
        <filter name="scheduled" string="Programadas" domain="[('state', '=', 'scheduled')]"/>
        <filter name="in_progress" string="En curso" domain="[('state', '=', 'in_progress')]"/>
        <filter name="done" string="Finalizadas" domain="[('state', '=', 'done')]"/>
        <group expand="0" string="Agrupar por">
          <filter name="gp_user" string="Asesor" context="{'group_by': 'user_id'}"/>
          <filter name="gp_zone" string="Zona" context="{'group_by': 'zone_id'}"/>
          <filter name="gp_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
          <filter name="gp_state" string="Estado" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_crm_visit_calendar" model="ir.ui.view">
    <field name="name">crm.visit.calendar</field>
    <field name="model">crm.visit</field>
    <field name="arch" type="xml">
      <calendar string="Visitas" date_start="scheduled_date" date_stop="scheduled_date_end"
                color="user_id">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="zone_id"/>
        <field name="state"/>
      </calendar>
    </field>
  </record>

  <record id="view_crm_visit_form" model="ir.ui.view">
    <field name="name">crm.visit.form</field>
    <field name="model">crm.visit</field>
    <field name="arch" type="xml">
      <form string="Visita">
        <header>
          <button name="%(crm_visit_route.action_gps_client_action)d"
                  type="action"
                  string="Capturar coordenadas"
                  class="btn-secondary"/>
          <button name="action_open_maps_single"
                  type="object"
                  string="Abrir en Maps"
                  class="btn-secondary"/>
          <button name="action_create_quotation"
                  type="object"
                  string="Generar cotización"
                  class="btn-primary"/>
          <button name="action_open_calendar"
                  type="object"
                  string="Calendario"
                  class="btn-secondary"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="partner_id" options="{'no_open': False}"/>
              <field name="user_id"/>
              <field name="zone_id"/>
              <field name="priority" widget="priority"/>
            </group>
            <group>
              <field name="scheduled_date"/>
              <field name="duration_minutes"/>
              <field name="scheduled_date_end" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Seguimiento">
              <group>
                <group string="Check-in">
                  <field name="checkin_time" readonly="1"/>
                  <field name="checkin_lat" readonly="1"/>
                  <field name="checkin_lng" readonly="1"/>
                </group>
                <group string="Check-out">
                  <field name="checkout_time" readonly="1"/>
                  <field name="checkout_lat" readonly="1"/>
                  <field name="checkout_lng" readonly="1"/>
                </group>
              </group>
            </page>
            <page string="Pedido">
              <field name="sale_order_id"
                     context="{'default_partner_id': partner_id, 'form_view_ref': 'crm_visit_route.view_sale_order_crm_visit_form'}"/>
            </page>
          </notebook>
        </sheet>
        <footer>
          <button name="%(crm_visit_route.action_crm_visit_optimize_wizard)d"
                  type="action"
                  string="Optimizar ruta"
                  class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
