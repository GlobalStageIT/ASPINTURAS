<odoo>
  <record id="action_crm_visit" model="ir.actions.act_window">
    <field name="name">Visitas</field>
    <field name="res_model">crm.visit</field>
    <field name="view_mode">calendar,tree,form</field>
  </record>

  <record id="action_crm_visit_plan" model="ir.actions.act_window">
    <field name="name">Plantillas de visitas</field>
    <field name="res_model">crm.visit.plan</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="action_crm_visit_zone" model="ir.actions.act_window">
    <field name="name">Zonas de visitas</field>
    <field name="res_model">crm.visit.zone</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_crm_visit_root" name="Rutas de visitas" parent="crm.crm_menu_root"/>

  <menuitem id="menu_crm_visit" name="Visitas" parent="menu_crm_visit_root"
            action="action_crm_visit" sequence="10"/>

  <menuitem id="menu_crm_visit_plan" name="Plantillas" parent="menu_crm_visit_root"
            action="action_crm_visit_plan" sequence="20"/>

  <menuitem id="menu_crm_visit_zone" name="Zonas" parent="menu_crm_visit_root"
            action="action_crm_visit_zone" sequence="30"/>

  <record id="action_crm_visit_optimize_wizard" model="ir.actions.act_window">
    <field name="name">Optimizar ruta</field>
    <field name="res_model">crm.visit.optimize.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_crm_visit_optimize_wizard"/>
    <field name="target">new</field>
  </record>
</odoo>
