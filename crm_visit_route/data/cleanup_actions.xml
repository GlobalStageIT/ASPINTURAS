<odoo>
  <record id="action_crm_visit_cleanup_studio_views" model="ir.actions.server">
    <field name="name">[CRM Visit] Desactivar vistas con ocapi_bindings</field>
    <field name="model_id" ref="base.model_ir_ui_view"/>
    <field name="state">code</field>
    <field name="code">
      action = env["ir.ui.view"].sudo().search([("arch_db", "ilike", "ocapi_bindings")]).write({"active": False})
    </field>
  </record>
</odoo>
