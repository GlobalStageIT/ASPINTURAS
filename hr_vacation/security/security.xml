<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_vacation_rule" model="ir.rule">
            <field name="name">Hr Vacation multi company rule</field>
            <field name="model_id" search="[('model','=','hr.vacation')]" model="ir.model"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
    <data>
        <record id="hr_leave_rule" model="ir.rule">
            <field name="name">Hr Leave multi company rule</field>
            <field name="model_id" search="[('model','=','hr.leave')]" model="ir.model"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>