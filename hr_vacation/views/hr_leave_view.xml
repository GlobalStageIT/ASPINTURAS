    <record id="hr_leave_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <!-- Ejemplo 1: Añadir un campo personalizado en el formulario -->
            <xpath expr="//field[@name='supported_attachment_ids']" position="attributes">
                <attribute name="required">leave_type_support_document == True</attribute>
            </xpath>

            <xpath expr="//field[@name='duration_display']" position="replace">
                <field name="number_of_days"/>
                <field name="employee_id"/>
                <field name="coach_id"  options="{'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>