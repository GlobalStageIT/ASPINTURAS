<odoo>
    <record id="view_res_partner_form_inherit_entity_type" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.entity.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="entity_type_ids" widget="many2many_tags"  options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
