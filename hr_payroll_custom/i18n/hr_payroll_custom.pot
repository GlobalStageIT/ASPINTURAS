#. module: hr_payroll_custom
#: model_terms:ir.ui.view,arch_db:hr_payroll_custom.report_report_payslip_custom
msgid ""
"1. Que el patrono ha incorporado en la presente liquidación los importes\n"
"                                correspondientes a\n"
"                                salarios, horas extras, descansos compensatorios, cesantías, vacaciones, prima de\n"
"                                servicios,\n"
"                                auxilio de transporte, y en sí, todo concepto relacionado con salarios, prestaciones o\n"
"                                indemnizaciones causadas al quedar extinguido el contrato de trabajo."
msgstr ""

#. module: hr_payroll_custom
#: model_terms:ir.ui.view,arch_db:hr_payroll_custom.report_report_payslip_custom
msgid ""
"2. Que con el pago del dinero anotado en la presente liquidación, queda transada\n"
"                                cualquier\n"
"                                diferencia relativa al contrato de trabajo extinguido, o a cualquier diferencia\n"
"                                anterior. Por lo\n"
"                                tanto, esta transacción tiene como efecto la terminación de las obligaciones\n"
"                                provenientes de la\n"
"                                relación laboral que existió entre"
msgstr ""

