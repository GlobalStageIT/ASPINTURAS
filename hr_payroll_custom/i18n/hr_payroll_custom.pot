#. module: hr_payroll_custom
#: model:mail.template,body_html:hr_payroll_custom.mail_template_payslip
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size:14px; color:#333; line-height:1.6; padding:20px; border:1px solid #ddd; border-radius:8px;\">\n"
"\n"
"                    <!-- Encabezado con logo -->\n"
"                    <div style=\"text-align:center; margin-bottom:20px;\">\n"
"                        <img t-att-src=\"'data:image/png;base64,%s' % object.company_id.logo\" alt=\"Company Logo\" style=\"max-height:80px; margin-bottom:10px;\"/>\n"
"                        <br/>\n"
"                        <span style=\"font-size:18px; font-weight:bold; color:#004080;\">\n"
"                            <t t-out=\"object.company_id.name\"/>\n"
"                        </span>\n"
"                    </div>\n"
"\n"
"                    <!-- Saludo -->\n"
"                    <p style=\"margin:0 0 15px 0;\">Dear\n"
"                        <strong>\n"
"                            <t t-out=\"object.employee_id.name or ''\"/>\n"
"                        </strong>\n"
"                        ,\n"
"                    </p>\n"
"\n"
"                    <!-- Mensaje principal -->\n"
"                    <p style=\"margin:0 0 15px 0;\">\n"
"                        Please find attached your payslip for the following period:\n"
"                        <br/>\n"
"                        <strong>\n"
"                            <t t-out=\"object.date_from\"/>\n"
"                            –\n"
"                            <t t-out=\"object.date_to\"/>\n"
"                        </strong>\n"
"                        .\n"
"                    </p>\n"
"\n"
"                    <!-- Nota de soporte -->\n"
"                    <p style=\"margin:0 0 20px 0;\">\n"
"                        If you have any questions regarding this payslip, please do not hesitate to\n"
"                        contact our <strong>HR / Accounting Department</strong>.\n"
"                    </p>\n"
"\n"
"                    <!-- Despedida -->\n"
"                    <p style=\"margin:0;\">Best regards,</p>\n"
"                    <p style=\"font-weight:bold; color:#004080; margin:0;\">\n"
"                        <t t-out=\"object.company_id.name\"/>\n"
"                    </p>\n"
"                </div>\n"
"\n"
"            "
msgstr ""

