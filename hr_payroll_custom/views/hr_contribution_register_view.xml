<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_contribution_register_form_hr_payroll_custom" model="ir.ui.view">
            <field name="name">.hr.contribution.register.form.hr_payroll_custom</field>
            <field name="model">hr.contribution.register</field>
            <field name="inherit_id" ref="hr_payroll_community.hr_contribution_register_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[1]" position="after">
                    <group>
                        <field name="partner_from_employee_contract"/>
                        <field name="field_id" widget = 'selection' invisible="not partner_from_employee_contract"
                            required="partner_from_employee_contract"/>
                    </group>
                </xpath>
           </field>
        </record>
    </data>
</odoo>