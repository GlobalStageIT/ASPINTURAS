<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_run_view_form_extend" model="ir.ui.view">
        <field name="name">hr_payslip_run_view_form_extend</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="before">
                <group>
                    <group>
                        <field name="payroll_period_id"/>
                    </group>
                    <group>
                        <field name="type"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
