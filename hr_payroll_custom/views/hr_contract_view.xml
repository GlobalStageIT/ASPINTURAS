<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_contract_view_form_hr_payroll_custom" model="ir.ui.view">
            <field name="name">hr.contract.view.form.hr_payroll_custom</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[1]" position="after">
                    <separator string="Withholding Payslip"/>
                    <group>
                        <group>
                            <field name="rtefte_incentivo_vivienda"/>
                            <field name="rtefte_aportes_vol_pens_empleador"/>
                            <field name="rtefte_pago_int_vivienda"/>
                        </group>
                        <group>
                            <field name="rtefte_pagos_med_prepagada"/>
                            <field name="rtefte_pagos_dependientes"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//page[@name='information']/group[@name='salary_info']/group[@name='salary']"
                       position="replace">
                    <group name="salary">
                        <field name="employment_category" string="Type of fees"/>
                        <label for="hourly_wage" invisible="employment_category=='employee'"/>
                        <div class="o_row mw-50" name="hourly_wage" invisible="employment_category=='employee'">
                            <field name="hourly_wage" class="oe_inline o_hr_narrow_field" string="Hourly Wage"/>
                            <div class="mb-3">/ hour</div>
                        </div>
                        <label for="wage" invisible="employment_category in ('contractor', 'freelancer')"/>
                        <div class="o_row mw-50" name="wage"
                             invisible="employment_category in ('contractor', 'freelancer')">
                            <field name="wage" class="oe_inline o_hr_narrow_field" nolabel="1"/>
                            <div class="mb-3" name="wage_period_label">/ month</div>
                        </div>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
