<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record id="paperformat_payroll" model="report.paperformat">
            <field name="name">Payroll</field>
            <field name="default" eval="True"/>
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">00</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
            <field name="css_margins" eval="True"/>
        </record>

        <template id="report_report_payslip_custom" inherit_id="hr_payroll_community.report_payslip">
            <xpath expr="//div[hasclass('page')]" position="replace">
                <div class="page" style="font-family: 'Poppins', Arial, sans-serif; color:#2c3e50; font-size:14px;">

                    <!-- Espacio superior -->
                    <div style="height:200px;"/>

                    <!-- Encabezado -->
                    <div style="text-align:center; padding-bottom:20px;">
                        <t t-if="o.is_liquidation">
                            <h3 style="text-align:center; color:#2c3e50; font-weight:600; font-size:18px;">
                                Comprobante de Liquidación
                            </h3>
                        </t>
                        <t t-else="">
                            <h3 style="text-align:center; color:#2c3e50; font-weight:600; font-size:18px;">
                                Comprobante de Nómina
                            </h3>
                        </t>
                        <p style="text-align:center; font-size:15px; color:#7f8c8d;" t-field="o.name"/>
                        <br/>
                    </div>

                    <!-- Información General -->
                    <h4 style="color:#3498db; font-weight:600; font-size:16px;">Información General</h4>
                    <table class="table table-sm"
                           style="table-layout: fixed; width:100%; border-radius:12px; border:1px solid #dfe6e9; border-collapse: separate; border-spacing:0; font-size:14px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); overflow:hidden;">
                        <tbody>
                            <t t-if="o.is_liquidation">
                                <tr style="background:#f9f9f9;">
                                    <td colspan="2">
                                        <strong>Fecha Inicio Contrato</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-field="o.contract_id.date_start"/>
                                    </td>
                                    <td colspan="2">
                                        <strong>Fecha Fin Contrato</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-field="o.date_liquidation"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <strong>Total Días Laborados</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-esc="o.get_total_worked_days()"/>
                                    </td>
                                    <td colspan="2">
                                        <strong>Total Días Ausentismos</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-esc="o.get_total_leaves()"/>
                                    </td>
                                </tr>
                                <tr style="background:#f9f9f9;">
                                    <td colspan="2">
                                        <strong>N° Ticket</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-esc="o.recruitment_requisition_id.name"/>
                                    </td>
                                    <td colspan="2">
                                        <strong>CECO</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-esc="o.recruitment_requisition_id.department_id2.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <strong>Tipo de contrato</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-esc="o.contract_id.type_contract_id.name"/>
                                    </td>
                                    <td colspan="2">
                                        <strong>Motivo de retiro</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-esc="o.get_resignation_type_value()"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr style="background:#f9f9f9;">
                                    <td colspan="2">
                                        <strong>Fecha Desde</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-field="o.date_from"/>
                                    </td>
                                    <td colspan="2">
                                        <strong>Fecha Hasta</strong>
                                    </td>
                                    <td colspan="2">
                                        <span t-field="o.date_to"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2">
                                    <strong>Comprobante Número</strong>
                                </td>
                                <td colspan="2">
                                    <span t-field="o.number"/>
                                </td>
                                <td colspan="2">
                                    <strong>Cuenta Bancaria</strong>
                                </td>
                                <td colspan="2">
                                    <t t-if="o.employee_id.bank_account_id">
                                        <t t-set="bank_id" t-value="o.employee_id.bank_account_id"/>
                                        <span t-esc="bank_id.bank_id.name + ' - ' + bank_id.acc_number"/>
                                    </t>
                                    <t t-else="">
                                        <span>No configurada</span>
                                    </t>
                                </td>
                            </tr>
                            <tr style="background:#f9f9f9;">
                                <td colspan="2">
                                    <strong>Nombre</strong>
                                </td>
                                <td colspan="2">
                                    <span t-field="o.employee_id.name"/>
                                </td>
                                <td colspan="2">
                                    <strong>No Identificación</strong>
                                </td>
                                <td colspan="2">
                                    <span t-field="o.employee_id.identification_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <strong>Cargo</strong>
                                </td>
                                <td colspan="6">
                                    <span t-field="o.employee_id.job_id.name"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <br/>

                    <!-- Tabla de Días -->
                    <h4 style="color:#3498db; font-weight:600; font-size:16px;">Detalle de Días</h4>
                    <table class="table table-sm"
                           style="table-layout: fixed; width:100%; border-radius:12px; border:1px solid #dfe6e9; border-collapse: separate; border-spacing:0; font-size:14px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); overflow:hidden;">
                        <thead style="background:#3498db; color:white; font-size:15px;">
                            <tr>
                                <th colspan="2">Descripción</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.worked_days_line_ids" t-as="line" t-foreach-index="idx"
                                t-attf-style="background: {{ '#f9f9f9' if (idx is not None and idx % 2) else 'white' }};">
                                <td colspan="2">
                                    <span t-field="line.name"/>
                                </td>
                                <td>
                                    <span t-field="line.number_of_days"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <br/>

                    <!-- Devengos y Deducciones -->
                    <h4 style="color:#3498db; font-weight:600; font-size:16px;">Devengos y Deducciones</h4>
                    <div class="row">
                        <!-- Devengos -->
                        <div class="col-6">
                            <table class="table table-sm"
                                   style="table-layout: fixed; width:100%; border-radius:12px; border:1px solid #dfe6e9; border-collapse: separate; border-spacing:0; font-size:14px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); overflow:hidden;">
                                <t t-set="total_income" t-value="0"/>
                                <thead style="background:#3498db; color:white; font-size:15px;">
                                    <tr>
                                        <th colspan="2">Devengos</th>
                                        <th>Cantidad</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.line_ids.filtered(lambda l: l.salary_rule_id.appears_on_payslip)"
                                        t-as="line" t-foreach-index="idx"
                                        t-if="line.salary_rule_id.type_concept == 'earn'"
                                        t-attf-style="background: {{ '#f9f9f9' if (idx is not None and idx % 2) else 'white' }};">
                                        <td colspan="2">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td>
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td>
                                            <span t-esc="'$ ' + '{:,.0f}'.format(line.total)"/>
                                            <t t-set="total_income" t-value="total_income + line.total"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- Deducciones -->
                        <div class="col-6">
                            <table class="table table-sm"
                                   style="table-layout: fixed; width:100%; border-radius:12px; border:1px solid #dfe6e9; border-collapse: separate; border-spacing:0; font-size:14px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); overflow:hidden;">
                                <t t-set="total_deduction" t-value="0"/>
                                <thead style="background:#3498db; color:white; font-size:15px;">
                                    <tr>
                                        <th colspan="2">Deducciones</th>
                                        <th>Cantidad</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.line_ids.filtered(lambda l: l.salary_rule_id.appears_on_payslip)"
                                        t-as="line" t-foreach-index="idx"
                                        t-if="line.salary_rule_id.type_concept == 'deduction'"
                                        t-attf-style="background: {{ '#f9f9f9' if (idx is not None and idx % 2) else 'white' }};">
                                        <td colspan="2">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td>
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td>
                                            <span t-esc="'$ ' + '{:,.0f}'.format(line.total)"/>
                                            <t t-set="total_deduction" t-value="total_deduction + line.total"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Totales -->
                    <table class="table table-sm"
                           style="margin-top: 15px; width:100%; border-radius:12px; border:1px solid #dfe6e9; border-collapse: separate; border-spacing:0; font-size:15px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); overflow:hidden;">
                        <tr style="background:#ecf0f1;">
                            <td colspan="2" style="text-align:center; font-weight:600;">Total Devengos</td>
                            <td colspan="2" style="text-align:center;">
                                <span t-esc="'$ ' + '{:,.0f}'.format(total_income)"/>
                            </td>
                            <td colspan="2" style="text-align:center; font-weight:600;">Total Deducciones</td>
                            <td colspan="2" style="text-align:center;">
                                <span t-esc="'$ ' + '{:,.0f}'.format(total_deduction)"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Neto a pagar -->
                    <table class="table table-sm"
                           style="margin-top: 10px; width:50%; float:right; border-radius:12px; border:1px solid #dfe6e9; border-collapse: separate; border-spacing:0; font-size:16px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); overflow:hidden;">
                        <tr style="background:#3498db; color:white;">
                            <td colspan="2" style="text-align:center;">
                                <h5>
                                    <strong>Neto a Pagar</strong>
                                </h5>
                            </td>
                            <td colspan="2" style="text-align:center;">
                                <h5>
                                    <strong t-esc="'$ ' + '{:,.0f}'.format(total_income - total_deduction)"/>
                                </h5>
                            </td>
                        </tr>
                    </table>

                    <!-- Texto Liquidación -->
                    <t t-if="o.is_liquidation">
                        <div style="margin-top: 120px; text-align: justify; font-size:14px; line-height:1.6;">
                            <h4 style="text-align:center; color:#2c3e50; font-weight:600;">
                                <strong>SE HACE CONSTAR:</strong>
                            </h4>
                            <p>
                                1. Que el patrono ha incorporado en la presente liquidación los importes
                                correspondientes
                                a salarios, horas extras, descansos compensatorios, cesantías, vacaciones, prima de
                                servicios,
                                auxilio de transporte, y todo concepto relacionado con salarios, prestaciones o
                                indemnizaciones.
                            </p>
                            <p>
                                2. Que con el pago del dinero anotado en la presente liquidación, queda transada
                                cualquier
                                diferencia relativa al contrato extinguido o a cualquier diferencia anterior. Por lo
                                tanto,
                                esta transacción tiene como efecto la terminación de las obligaciones provenientes de la
                                relación laboral que existió entre
                                <span t-field="o.company_id.name"/>
                                y el trabajador.
                            </p>
                            <div style="display: flex; justify-content: space-between; margin-top: 120px;">
                                <div style="text-align: left; margin-left: 50px;">
                                    <strong>________________________________</strong>
                                    <br/>
                                    El trabajador
                                    <br/>
                                    <span t-esc="o.employee_id.name"/>
                                    <br/>
                                    <span t-esc="o.employee_id.private_vat"/>
                                </div>
                                <div style="text-align: right; margin-right: 50px;">
                                    <strong>________________________________</strong>
                                    <br/>
                                    Por la empresa
                                    <br/>
                                    <span t-esc="o.company_id.name"/>
                                    <br/>
                                    <span t-esc="o.company_id.vat"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </xpath>
        </template>

        <!--Report action for Payslip Details Report-->
        <record id="hr_payslip_report_action_custom" model="ir.actions.report">
            <field name="name">Payslip Batch</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="binding_model_id" ref="model_hr_payslip"/>
            <field name="report_name">hr_payroll_community.report_payslip</field>
            <field name="report_file">hr_payroll_community.report_payslip</field>
            <field name="print_report_name">('Payslip - %s' % (object.employee_id.name))</field>
            <field name="paperformat_id" ref="paperformat_payroll"/>
        </record>

    </data>
</odoo>