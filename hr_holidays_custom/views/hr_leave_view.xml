<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_tree_hr_holidays_custom" model="ir.ui.view">
        <field name="name">hr.leave.tree.hr_holidays_custom</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <field name="date_from" position="replace">
                <field name="request_date_from"/>
            </field>
            <field name="date_to" position="replace">
                <field name="request_date_to"/>
            </field>
            <field name="employee_id" position="before">
                <field name="create_date" string="Application date" widget="date"/>
            </field>
            <field name="state" position="after">
                <field name="first_approver_id"/>
                <field name="second_approver_id"/>
            </field>
        </field>
    </record>

    <record id="hr_leave_view_form_hr_holiday_custom" model="ir.ui.view">
        <field name="name">hr.leave.view.form.hr_holiday_custom</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="before">
                <field name="contract_id" force_save="1" invisible="1"/>
                <br/>
                <div invisible="contract_id"
                     class="alert text-center alert-danger alert-dismissible" role="alert"
                     style="margin-bottom:2px;">
                    <strong>You must select a contract.</strong>
                    If you do not have an active contract available for selection, please contact the administrator.
                </div>
                <br/>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="replace">
                <field name="holiday_status_id" force_save="1"
                       domain="['|',
                       ('requires_allocation', '=', 'no'),
                       '&amp;',
                       ('has_valid_allocation', '=', True),
                       '|',
                       ('allows_negative', '=', True),
                       '&amp;',
                       ('virtual_remaining_leaves', '&gt;', 0), ('allows_negative', '=', False), ('appears_leave', '=', True)]"
                       context="{'employee_id': employee_id, 'default_date_from': date_from, 'default_date_to': date_to}"
                       options="{'no_create': True, 'no_open': True, 'request_type': 'leave'}"
                       readonly="state in ['cancel', 'refuse', 'validate', 'validate1']"/>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="before">
                <field name="contract_id" domain="[('employee_id', '=', employee_id), ('state', '=', 'open')]"
                       options="{'no_open': True, 'no_create': True}" required="1" force_save="1"
                       context="{'default_employee_id': employee_id}"/>
            </xpath>
        </field>
    </record>
</odoo>
